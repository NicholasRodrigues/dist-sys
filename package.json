{
  "name": "bilheteria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma distribuida de venda de ingressos sob pico de demanda",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --testTimeout=60000",
    "seed": "node dist/tools/seed.js",
    "invariants": "node dist/tools/invariants.js",
    "smoke": "node dist/tools/smoke.js",
    "chaos": "node dist/tools/chaos.js",
    "flags": "node dist/tools/flags.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
